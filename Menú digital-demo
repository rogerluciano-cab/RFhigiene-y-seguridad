<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menú Digital - El Bodegón del Socio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }
        .font-serif {
            font-family: 'Cinzel', serif;
        }
        /* Barra de scroll personalizada */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1c1917;
        }
        ::-webkit-scrollbar-thumb {
            background: #d97706;
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-stone-950 text-stone-100 min-h-screen pb-24 selection:bg-amber-500 selection:text-stone-950">

    <!-- Banner de Bienvenida y Encabezado -->
    <header class="relative bg-stone-900 border-b border-stone-800 text-center py-8 px-4 overflow-hidden">
        <!-- Luces de fondo decorativas -->
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-red-500/10 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 max-w-md mx-auto">
            <span class="inline-block px-3 py-1 bg-amber-500/10 text-amber-500 text-xs font-bold uppercase tracking-widest rounded-full mb-3 border border-amber-500/20">
                Estilo Bodegón Argentino
            </span>
            <h1 class="text-3xl font-bold font-serif text-amber-500 tracking-wide">EL BODEGÓN DEL SOCIO</h1>
            <p class="text-stone-400 text-sm mt-1">Abundante, casero y bien argentino • Mesa 12</p>
            
            <!-- Acciones Rápidas -->
            <div class="grid grid-cols-2 gap-3 mt-6">
                <button onclick="callWaiter()" class="flex items-center justify-center gap-2 bg-stone-800 hover:bg-stone-700 border border-stone-700 py-3 px-4 rounded-xl text-sm font-semibold transition-all active:scale-95 shadow-md">
                    <span>🔔</span> Llamar al Mozo
                </button>
                <button onclick="openReviewModal()" class="flex items-center justify-center gap-2 bg-stone-800 hover:bg-stone-700 border border-stone-700 py-3 px-4 rounded-xl text-sm font-semibold transition-all active:scale-95 shadow-md">
                    <span>⭐</span> Dejar Reseña
                </button>
            </div>
        </div>
    </header>

    <!-- Selector de Categorías (Fijo al hacer scroll) -->
    <nav class="sticky top-0 bg-stone-950/90 backdrop-blur-md border-b border-stone-900 py-4 z-40">
        <div class="max-w-md mx-auto px-4 flex gap-2 overflow-x-auto whitespace-nowrap">
            <button onclick="filterCategory('all', this)" class="category-btn px-4 py-2 bg-amber-600 text-stone-950 font-bold rounded-xl text-sm transition-all duration-200">
                Todo el Menú
            </button>
            <button onclick="filterCategory('entradas', this)" class="category-btn px-4 py-2 bg-stone-900 border border-stone-800 hover:border-stone-700 text-stone-300 font-semibold rounded-xl text-sm transition-all duration-200">
                Entradas
            </button>
            <button onclick="filterCategory('principales', this)" class="category-btn px-4 py-2 bg-stone-900 border border-stone-800 hover:border-stone-700 text-stone-300 font-semibold rounded-xl text-sm transition-all duration-200">
                Platos Fuertes
            </button>
            <button onclick="filterCategory('bebidas', this)" class="category-btn px-4 py-2 bg-stone-900 border border-stone-800 hover:border-stone-700 text-stone-300 font-semibold rounded-xl text-sm transition-all duration-200">
                Bebidas y Vinos
            </button>
            <button onclick="filterCategory('postres', this)" class="category-btn px-4 py-2 bg-stone-900 border border-stone-800 hover:border-stone-700 text-stone-300 font-semibold rounded-xl text-sm transition-all duration-200">
                Postres
            </button>
        </div>
    </nav>

    <!-- Contenedor del Menú -->
    <main class="p-4 max-w-md mx-auto">
        <div id="menu-container" class="space-y-4">
            <!-- Se inyecta con JS -->
        </div>
    </main>

    <!-- Barra Inferior Flotante (Aparece cuando sumás algo) -->
    <div id="bottom-cart-bar" class="fixed bottom-0 left-0 right-0 bg-stone-900 border-t border-stone-800 p-4 z-40 transform translate-y-full transition-transform duration-300 shadow-2xl">
        <div class="max-w-md mx-auto flex justify-between items-center">
            <div>
                <span class="text-xs text-stone-400 block">Total de tu pedido</span>
                <span class="text-xl font-bold text-amber-500 font-serif">$<span id="bar-total">0</span></span>
            </div>
            <button onclick="toggleCartModal(true)" class="bg-amber-500 hover:bg-amber-600 text-stone-950 px-6 py-3 rounded-xl font-bold text-sm flex items-center gap-2 transition-all duration-200 shadow-lg shadow-amber-500/10">
                Ver Mi Pedido <span class="bg-stone-950 text-amber-500 text-xs px-2 py-0.5 rounded-full" id="bar-count">0</span>
            </button>
        </div>
    </div>

    <!-- MODAL PRINCIPAL DEL CARRITO -->
    <div id="cart-modal" class="hidden fixed inset-0 bg-stone-950/95 backdrop-blur-sm z-50 p-6 flex flex-col justify-between">
        <div class="max-w-md mx-auto w-full flex-1 flex flex-col overflow-hidden">
            <!-- Encabezado -->
            <div class="flex justify-between items-center border-b border-stone-800 pb-4 mb-4">
                <h2 class="text-2xl font-bold font-serif text-amber-500">🛒 Mi Pedido</h2>
                <button onclick="toggleCartModal(false)" class="text-stone-400 hover:text-white text-2xl font-semibold">&times;</button>
            </div>
            
            <!-- Items en Carrito -->
            <div id="cart-items" class="flex-1 overflow-y-auto space-y-3 pr-1">
                <!-- Se inyecta con JS -->
            </div>

            <!-- Totales y Envío -->
            <div class="border-t border-stone-800 pt-4 mt-4 bg-stone-950">
                <div class="flex justify-between items-center mb-6">
                    <span class="text-lg text-stone-300">Total acumulado:</span>
                    <span class="text-2xl font-bold font-serif text-amber-500">$<span id="cart-total">0</span></span>
                </div>
                
                <div class="space-y-3">
                    <button onclick="sendOrder()" class="w-full bg-green-600 hover:bg-green-700 text-white p-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all duration-200 shadow-lg">
                        <span>💬</span> Confirmar y Mandar por WhatsApp
                    </button>
                    <button onclick="toggleCartModal(false)" class="w-full text-center py-2 text-sm text-stone-400 hover:text-stone-300">
                        Volver a ver la carta
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL LLAMAR MOZO -->
    <div id="waiter-modal" class="hidden fixed inset-0 bg-stone-950/90 backdrop-blur-md z-50 flex items-center justify-center p-6">
        <div class="bg-stone-900 border border-stone-800 p-6 rounded-2xl max-w-sm w-full text-center shadow-2xl relative">
            <button onclick="closeWaiterModal()" class="absolute top-4 right-4 text-stone-500 hover:text-stone-300 text-lg">&times;</button>
            <div class="w-16 h-16 bg-amber-500/10 text-amber-500 text-3xl flex items-center justify-center rounded-full mx-auto mb-4">🔔</div>
            <h3 class="text-xl font-bold font-serif text-amber-500 mb-2">¿Necesitás un Mozo?</h3>
            <p class="text-stone-400 text-sm mb-6">Elegí la razón para que el mozo vaya directo a tu mesa con lo que necesitás:</p>
            <div class="space-y-2">
                <button onclick="requestWaiterAction('Pedir la cuenta')" class="w-full bg-stone-800 hover:bg-stone-700 p-3 rounded-xl text-sm font-semibold text-stone-200 transition-all">💵 Traer la cuenta / Factura</button>
                <button onclick="requestWaiterAction('Consultar sobre la carta')" class="w-full bg-stone-800 hover:bg-stone-700 p-3 rounded-xl text-sm font-semibold text-stone-200 transition-all">❓ Consulta sobre un plato</button>
                <button onclick="requestWaiterAction('Otro motivo / Llamar mozo')" class="w-full bg-amber-600 hover:bg-amber-700 p-3 rounded-xl text-sm font-bold text-stone-950 transition-all">🙋 Solicitar Mozo a la mesa</button>
            </div>
        </div>
    </div>

    <!-- MODAL RESEÑAS -->
    <div id="review-modal" class="hidden fixed inset-0 bg-stone-950/90 backdrop-blur-md z-50 flex items-center justify-center p-6">
        <div class="bg-stone-900 border border-stone-800 p-6 rounded-2xl max-w-sm w-full shadow-2xl relative">
            <button onclick="closeReviewModal()" class="absolute top-4 right-4 text-stone-500 hover:text-stone-300 text-lg">&times;</button>
            <div class="text-center mb-4">
                <div class="w-16 h-16 bg-red-500/10 text-red-500 text-3xl flex items-center justify-center rounded-full mx-auto mb-4">⭐</div>
                <h3 class="text-xl font-bold font-serif text-amber-500">¿Qué te pareció la comida?</h3>
                <p class="text-stone-400 text-xs">Tu opinión nos ayuda a mantener viva la tradición del bodegón</p>
            </div>
            
            <div class="flex justify-center gap-2 mb-6">
                <!-- Botones de estrellas -->
                <button onclick="setStarRating(1)" class="star-btn text-2xl text-stone-600 hover:scale-110 transition-transform">★</button>
                <button onclick="setStarRating(2)" class="star-btn text-2xl text-stone-600 hover:scale-110 transition-transform">★</button>
                <button onclick="setStarRating(3)" class="star-btn text-2xl text-stone-600 hover:scale-110 transition-transform">★</button>
                <button onclick="setStarRating(4)" class="star-btn text-2xl text-stone-600 hover:scale-110 transition-transform">★</button>
                <button onclick="setStarRating(5)" class="star-btn text-2xl text-stone-600 hover:scale-110 transition-transform">★</button>
            </div>

            <textarea id="review-text" rows="3" placeholder="Contanos qué plato te gustó más..." class="w-full bg-stone-950 border border-stone-800 focus:border-amber-500 focus:outline-none p-3 rounded-xl text-stone-200 text-sm placeholder:text-stone-600 mb-4 resize-none"></textarea>
            
            <button onclick="submitReview()" class="w-full bg-amber-600 hover:bg-amber-700 p-3 rounded-xl text-sm font-bold text-stone-950 transition-all">Enviar Reseña</button>
        </div>
    </div>

    <!-- Alertas Flotantes (Toast) -->
    <div id="toast" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-stone-900 border border-stone-800 text-amber-500 py-3 px-6 rounded-full text-sm font-bold shadow-2xl z-50 transition-all duration-300 opacity-0 pointer-events-none flex items-center gap-2">
        <span>✅</span> <span id="toast-message">Acción procesada con éxito</span>
    </div>

    <script>
        // Carta de platos del Bodegón
        const menuData = [
            { id: 1, name: "Tabla de Achuras", price: 9500, cat: "entradas", desc: "Chorizo, morcilla, bombón de molleja y chinchulines crocantes al limón", isPromo: true },
            { id: 2, name: "Empanada Cortada a Cuchillo", price: 1800, cat: "entradas", desc: "Frita, super jugosa, rellena de carne seleccionada y verdeo", isPromo: false },
            { id: 3, name: "Provoleta Especial El Bodegón", price: 4200, cat: "entradas", desc: "Crocante por fuera, fundida por dentro con orégano fresco y oliva", isPromo: false },
            
            { id: 4, name: "Milanesa de Ternera Gigante a la Napolitana", price: 15500, cat: "principales", desc: "Para compartir. Con salsa fileto casera, jamón, muzzarella gratinada y papas fritas bastón", isPromo: true },
            { id: 5, name: "Bife de Chorizo Mariposa (400g)", price: 16800, cat: "principales", desc: "Asado a punto con chimichurri casero de la casa y puré cremoso de papas", isPromo: false },
            { id: 6, name: "Ravioles de Espinaca y Ricota", price: 11000, cat: "principales", desc: "Caseros, amasados hoy. Bañados con estofado de carne abundante", isPromo: false },
            
            { id: 7, name: "Vino Malbec Gran Reserva", price: 12000, cat: "bebidas", desc: "Botella 750cc. Bodega seleccionada del Valle de Uco, Mendoza", isPromo: false },
            { id: 8, name: "Sifón de Soda de Litro", price: 1200, cat: "bebidas", desc: "Vidrio tradicional, bien helado para acompañar la mesa", isPromo: false },
            { id: 9, name: "Cerveza Patagonia Amber Lager", price: 4800, cat: "bebidas", desc: "Botella de un litro, temperatura bajo cero para compartir", isPromo: false },
            
            { id: 10, name: "Flan Mixto Tradicional", price: 3500, cat: "postres", desc: "Casero de verdad, con generosas cucharadas de dulce de leche colonial y crema montada", isPromo: true },
            { id: 11, name: "Don Pedro con Helado de Crema", price: 4800, cat: "postres", desc: "Copa helada de crema americana, shot de whisky importado y nueces pecan picadas", isPromo: false }
        ];

        let cart = [];
        let currentRating = 0;

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = message;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // Renderizar platos de la carta
        function renderMenu(filter = 'all') {
            const container = document.getElementById('menu-container');
            container.innerHTML = '';
            
            const filtered = filter === 'all' ? menuData : menuData.filter(item => item.cat === filter);
            
            filtered.forEach(item => {
                const promoBadge = item.isPromo ? `<span class="bg-red-900/50 border border-red-700/30 text-red-400 text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-wider ml-2">Recomendado</span>` : '';
                
                container.innerHTML += `
                    <div class="bg-stone-900 border border-stone-850 hover:border-stone-800 p-4 rounded-2xl flex justify-between items-start gap-4 transition-all duration-200">
                        <div class="flex-1">
                            <div class="flex items-center">
                                <h3 class="font-bold text-stone-100 text-lg">${item.name}</h3>
                                ${promoBadge}
                            </div>
                            <p class="text-sm text-stone-400 mt-1 leading-relaxed">${item.desc}</p>
                            <p class="text-amber-500 font-bold font-serif mt-3 text-lg">$${item.price.toLocaleString('es-AR')}</p>
                        </div>
                        <div class="flex flex-col items-center gap-2">
                            <button onclick="addToCart(${item.id})" class="bg-amber-500 hover:bg-amber-600 active:scale-95 text-stone-950 w-11 h-11 flex items-center justify-center rounded-xl font-black text-xl transition-all duration-150 shadow-md">
                                +
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function filterCategory(cat, buttonElement) {
            renderMenu(cat);
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.className = "category-btn px-4 py-2 bg-stone-900 border border-stone-800 text-stone-300 font-semibold rounded-xl text-sm transition-all duration-200";
            });
            buttonElement.className = "category-btn px-4 py-2 bg-amber-600 text-stone-950 font-bold rounded-xl text-sm transition-all duration-200";
        }

        // Lógica del Carrito de Pedidos
        function addToCart(id) {
            const item = menuData.find(i => i.id === id);
            const exist = cart.find(i => i.id === id);
            
            if (exist) {
                exist.quantity++;
            } else {
                cart.push({ ...item, quantity: 1 });
            }
            
            showToast(`Agregado: ${item.name}`);
            updateCartUI();
        }

        function changeQuantity(id, change) {
            const item = cart.find(i => i.id === id);
            if (!item) return;
            
            item.quantity += change;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.id !== id);
            }
            updateCartUI();
        }

        function updateCartUI() {
            const totalCount = cart.reduce((acc, curr) => acc + curr.quantity, 0);
            const totalPrice = cart.reduce((acc, curr) => acc + (curr.price * curr.quantity), 0);
            
            document.getElementById('bar-count').innerText = totalCount;
            document.getElementById('bar-total').innerText = totalPrice.toLocaleString('es-AR');
            document.getElementById('cart-total').innerText = totalPrice.toLocaleString('es-AR');
            
            const bottomBar = document.getElementById('bottom-cart-bar');
            if (totalCount > 0) {
                bottomBar.classList.remove('translate-y-full');
            } else {
                bottomBar.classList.add('translate-y-full');
                toggleCartModal(false);
            }
            
            const cartItemsContainer = document.getElementById('cart-items');
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `<div class="text-center py-12 text-stone-500">Tu bandeja de pedidos está vacía</div>`;
                return;
            }
            
            cartItemsContainer.innerHTML = cart.map(item => `
                <div class="bg-stone-900 border border-stone-850 p-4 rounded-xl flex justify-between items-center">
                    <div>
                        <h4 class="font-bold text-stone-100">${item.name}</h4>
                        <span class="text-sm text-amber-500 font-serif block mt-1">$${(item.price * item.quantity).toLocaleString('es-AR')}</span>
                    </div>
                    <div class="flex items-center gap-3 bg-stone-950 border border-stone-800 rounded-lg p-1">
                        <button onclick="changeQuantity(${item.id}, -1)" class="w-8 h-8 flex items-center justify-center font-bold text-stone-400 hover:text-white">-</button>
                        <span class="font-bold text-sm w-4 text-center">${item.quantity}</span>
                        <button onclick="changeQuantity(${item.id}, 1)" class="w-8 h-8 flex items-center justify-center font-bold text-stone-400 hover:text-white">+</button>
                    </div>
                </div>
            `).join('');
        }

        function toggleCartModal(show) {
            const modal = document.getElementById('cart-modal');
            if (show) {
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
        }

        // Integración del Pedido final con WhatsApp
        function sendOrder() {
            const tableNumber = "12";
            const total = document.getElementById('cart-total').innerText;
            const itemsText = cart.map(i => `• ${i.quantity}x ${i.name} ($${(i.price * i.quantity).toLocaleString('es-AR')})`).join('\n');
            
            const message = `🍖 *EL BODEGÓN DEL SOCIO* 🍖\n📍 *Pedido en mesa ${tableNumber}*\n\nDetalle:\n${itemsText}\n\n💵 *Total: $${total}*`;
            
            const whatsappNumber = "5493546000000"; // Número real de WhatsApp del local
            window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
        }

        // Funciones del Mozo
        function callWaiter() {
            document.getElementById('waiter-modal').classList.remove('hidden');
        }

        function closeWaiterModal() {
            document.getElementById('waiter-modal').classList.add('hidden');
        }

        function requestWaiterAction(reason) {
            const tableNumber = "12";
            const message = `🔔 *LLAMADO DE MOZO*\n📍 *Mesa ${tableNumber}*\n💬 *Motivo:* ${reason}`;
            const whatsappNumber = "5493546000000"; // Número real de WhatsApp del local
            
            closeWaiterModal();
            showToast("Llamando al mozo...");
            
            setTimeout(() => {
                window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
            }, 1000);
        }

        // Funciones de Reseñas / Calificaciones
        function openReviewModal() {
            document.getElementById('review-modal').classList.remove('hidden');
            currentRating = 0;
            resetStars();
            document.getElementById('review-text').value = '';
        }

        function closeReviewModal() {
            document.getElementById('review-modal').classList.add('hidden');
        }

        function setStarRating(rating) {
            currentRating = rating;
            const stars = document.querySelectorAll('.star-btn');
            stars.forEach((star, index) => {
                if (index < rating) {
                    star.classList.add('text-amber-500');
                    star.classList.remove('text-stone-600');
                } else {
                    star.classList.remove('text-amber-500');
                    star.classList.add('text-stone-600');
                }
            });
        }

        function resetStars() {
            const stars = document.querySelectorAll('.star-btn');
            stars.forEach(star => {
                star.classList.remove('text-amber-500');
                star.classList.add('text-stone-600');
            });
        }

        function submitReview() {
            const text = document.getElementById('review-text').value;
            if (currentRating === 0) {
                alert("Por favor elegí una puntuación de estrellas.");
                return;
            }
            
            closeReviewModal();
            showToast("¡Muchas gracias por tu reseña!");
            console.log(`Reseña enviada: ${currentRating} estrellas. Comentario: ${text}`);
        }

        // Inicialización
        renderMenu();
    </script>
</body>
</html>
