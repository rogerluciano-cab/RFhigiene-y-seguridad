<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>El Rey del Lomito - Delivery Express</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #fbf9f4; /* Fondo crema cálido súper apetitoso */
        }
        .font-brand {
            font-family: 'Playfair Display', serif;
        }
        /* Ocultar flechas de inputs de número */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
    </style>
</head>
<body class="text-stone-800 min-h-screen pb-32 selection:bg-rose-600 selection:text-white">

    <!-- Encabezado Estilo "Rotisería Boutique" -->
    <header class="relative bg-[#1e1b18] text-center py-10 px-4 overflow-hidden shadow-md">
        <!-- Textura de fondo sutil o destello cálido -->
        <div class="absolute -top-24 -left-24 w-56 h-56 bg-amber-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-24 -right-24 w-56 h-56 bg-rose-500/10 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 max-w-md mx-auto">
            <span class="inline-block px-3 py-1 bg-amber-500/10 text-amber-400 text-[10px] font-bold uppercase tracking-widest rounded-md mb-3 border border-amber-500/20">
                Lomitos, Pizzas y Empanadas
            </span>
            <h1 class="text-4xl font-brand italic text-[#fbf9f4] tracking-tight">El Rey del Lomito</h1>
            <p class="text-stone-400 text-xs mt-2 font-light">Hacé tu pedido online • Te llega calentito al toque 🛵</p>
        </div>
    </header>

    <main class="p-4 max-w-md mx-auto space-y-8">

        <!-- CATEGORÍA 1: LOMITOS -->
        <section class="space-y-4">
            <div class="flex items-center gap-2 border-b border-stone-200 pb-2">
                <span class="text-xl">🍔</span>
                <h2 class="text-lg font-extrabold tracking-tight text-stone-900 uppercase">Lomitos Giga</h2>
            </div>
            
            <div class="space-y-3">
                <!-- Item 1 -->
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-150 flex justify-between items-start gap-4 hover:shadow-md transition-shadow">
                    <div class="flex-1">
                        <h3 class="font-bold text-stone-900 text-sm">Lomito Completo</h3>
                        <p class="text-[11px] text-stone-500 mt-1 leading-relaxed">Carne tiernizada, jamón, queso, huevo, lechuga, tomate y mayonesa casera de la casa. Viene con papas fritas.</p>
                        <span class="text-rose-600 font-extrabold block mt-2 text-sm">$6.500</span>
                    </div>
                    <button onclick="addToCart(1, 'Lomito Completo', 6500)" class="bg-amber-500 hover:bg-amber-600 active:scale-95 text-stone-950 w-10 h-10 flex items-center justify-center rounded-xl font-bold text-xl transition-all shadow-sm">+</button>
                </div>
            </div>
        </section>

        <!-- CATEGORÍA 2: EMPANADAS -->
        <section class="space-y-4">
            <div class="flex items-center justify-between border-b border-stone-200 pb-2">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🥟</span>
                    <h2 class="text-lg font-extrabold tracking-tight text-stone-900 uppercase">Empanadas Caseras</h2>
                </div>
                <span class="text-[10px] bg-stone-200 text-stone-700 px-2.5 py-1 rounded-full font-bold">$900 c/u</span>
            </div>
            
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-150 space-y-4">
                <p class="text-[11px] text-stone-500">Armá tu docena o las que quieras. El sistema te calcula el total sin vueltas.</p>
                
                <!-- Sabores -->
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-stone-700 font-semibold">Carne Suave</span>
                        <div class="flex items-center gap-2 bg-stone-50 p-1 rounded-xl border border-stone-200">
                            <button onclick="changeEmpanadaFlavor('Carne Suave', -1)" class="w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-900 font-bold text-md">-</button>
                            <span id="flavor-CarneSuave" class="w-6 text-center font-bold text-xs text-stone-800">0</span>
                            <button onclick="changeEmpanadaFlavor('Carne Suave', 1)" class="w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-900 font-bold text-md">+</button>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-stone-700 font-semibold">Jamón y Queso</span>
                        <div class="flex items-center gap-2 bg-stone-50 p-1 rounded-xl border border-stone-200">
                            <button onclick="changeEmpanadaFlavor('Jamón y Queso', -1)" class="w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-900 font-bold text-md">-</button>
                            <span id="flavor-JamonYQueso" class="w-6 text-center font-bold text-xs text-stone-800">0</span>
                            <button onclick="changeEmpanadaFlavor('Jamón y Queso', 1)" class="w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-900 font-bold text-md">+</button>
                        </div>
                    </div>

                    <div class="flex justify-between items-center text-sm">
                        <span class="text-stone-700 font-semibold">Humita / Choclo</span>
                        <div class="flex items-center gap-2 bg-stone-50 p-1 rounded-xl border border-stone-200">
                            <button onclick="changeEmpanadaFlavor('Humita', -1)" class="w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-900 font-bold text-md">-</button>
                            <span id="flavor-Humita" class="w-6 text-center font-bold text-xs text-stone-800">0</span>
                            <button onclick="changeEmpanadaFlavor('Humita', 1)" class="w-8 h-8 flex items-center justify-center text-stone-500 hover:text-stone-900 font-bold text-md">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CATEGORÍA 3: BEBIDAS -->
        <section class="space-y-4">
            <div class="flex items-center gap-2 border-b border-stone-200 pb-2">
                <span class="text-xl">🥤</span>
                <h2 class="text-lg font-extrabold tracking-tight text-stone-900 uppercase">Bebidas</h2>
            </div>
            <div class="space-y-3">
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-150 flex justify-between items-start gap-4 hover:shadow-md transition-shadow">
                    <div class="flex-1">
                        <h3 class="font-bold text-stone-900 text-sm">Coca-Cola 1.5 Litros</h3>
                        <p class="text-[11px] text-stone-500 mt-1 leading-relaxed">Línea original, bien helada.</p>
                        <span class="text-rose-600 font-extrabold block mt-2 text-sm">$2.200</span>
                    </div>
                    <button onclick="addToCart(2, 'Coca-Cola 1.5L', 2200)" class="bg-amber-500 hover:bg-amber-600 active:scale-95 text-stone-950 w-10 h-10 flex items-center justify-center rounded-xl font-bold text-xl transition-all shadow-sm">+</button>
                </div>
            </div>
        </section>

    </main>

    <!-- Barra Inferior Flotante (Llamativa y en sintonía) -->
    <div id="cart-bar" class="fixed bottom-0 left-0 right-0 bg-[#1e1b18] text-[#fbf9f4] p-4 z-40 transform translate-y-full transition-transform duration-300 shadow-2xl border-t border-stone-800">
        <div class="max-w-md mx-auto flex justify-between items-center">
            <div>
                <span class="text-[9px] text-stone-400 block uppercase tracking-wider">Tu pedido al momento</span>
                <span class="text-xl font-black text-amber-400">$<span id="bar-total">0</span></span>
            </div>
            <button onclick="openCheckoutModal()" class="bg-rose-600 hover:bg-rose-700 active:scale-95 text-white px-5 py-3 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition-all shadow-lg shadow-rose-600/20">
                Confirmar Datos <span class="bg-white text-rose-600 text-[10px] px-2 py-0.5 rounded-full font-black" id="bar-count">0</span>
            </button>
        </div>
    </div>

    <!-- MODAL DE CHECKOUT -->
    <div id="checkout-modal" class="hidden fixed inset-0 bg-[#1e1b18]/95 backdrop-blur-sm z-50 p-6 flex flex-col justify-between overflow-y-auto text-[#fbf9f4]">
        <div class="max-w-md mx-auto w-full flex-1 flex flex-col justify-between">
            <div>
                <!-- Encabezado -->
                <div class="flex justify-between items-center border-b border-stone-800 pb-4 mb-4">
                    <h2 class="text-xl font-brand italic text-amber-400">🛵 Datos de Entrega</h2>
                    <button onclick="closeCheckoutModal()" class="text-stone-400 hover:text-white text-3xl">&times;</button>
                </div>

                <!-- Detalle del pedido rápido -->
                <div class="bg-[#292420] p-4 rounded-2xl border border-stone-800 mb-4">
                    <h3 class="text-[10px] font-bold text-amber-400 uppercase tracking-widest mb-2">Resumen de compra</h3>
                    <div id="checkout-summary" class="space-y-1.5 text-xs text-stone-200">
                        <!-- Inyectado dinámicamente -->
                    </div>
                </div>

                <!-- Formulario -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-bold uppercase text-stone-400 mb-1">Tu Nombre</label>
                        <input type="text" id="client-name" placeholder="Ej. Carlos Pérez" class="w-full bg-[#292420] border border-stone-800 focus:border-amber-500 focus:outline-none p-3.5 rounded-xl text-xs text-stone-100 placeholder:text-stone-600">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold uppercase text-stone-400 mb-1">¿Cómo lo querés?</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="setDeliveryMethod('delivery')" id="btn-delivery" class="py-3 px-4 bg-rose-600 text-white font-bold text-xs uppercase rounded-xl transition-all">🛵 Envío a casa</button>
                            <button onclick="setDeliveryMethod('takeaway')" id="btn-takeaway" class="py-3 px-4 bg-[#292420] border border-stone-800 text-stone-300 font-semibold text-xs uppercase rounded-xl transition-all">🏪 Retiro en local</button>
                        </div>
                    </div>

                    <div id="address-container">
                        <label class="block text-[10px] font-bold uppercase text-stone-400 mb-1">Dirección de entrega</label>
                        <input type="text" id="client-address" placeholder="Ej. Belgrano 450, Villa del Rosario" class="w-full bg-[#292420] border border-stone-800 focus:border-amber-500 focus:outline-none p-3.5 rounded-xl text-xs text-stone-100 placeholder:text-stone-600">
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold uppercase text-stone-400 mb-1">¿Con cuánto vas a pagar? (Opcional)</label>
                        <input type="number" id="payment-change" placeholder="Ej. Pago con billete de $10.000" class="w-full bg-[#292420] border border-stone-800 focus:border-amber-500 focus:outline-none p-3.5 rounded-xl text-xs text-stone-100 placeholder:text-stone-600">
                        <p class="text-[9px] text-[#8e857c] mt-1">Ingresalo si necesitás que el delivery te lleve cambio exacto.</p>
                    </div>
                </div>
            </div>

            <!-- Botón Final de Envío -->
            <div class="border-t border-stone-800 pt-4 mt-6">
                <button onclick="sendOrder()" class="w-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white py-4 rounded-xl font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 transition-all shadow-lg shadow-emerald-900/10">
                    <span>💬</span> Enviar Pedido por WhatsApp
                </button>
            </div>
        </div>
    </div>

    <!-- Alertas Flotantes (Toast) -->
    <div id="toast" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-[#1e1b18] text-amber-400 py-3 px-6 rounded-full text-xs font-bold shadow-2xl z-50 transition-all duration-300 opacity-0 pointer-events-none">
        ✅ Agregado al pedido
    </div>

    <script>
        let cart = [];
        let empanadas = {
            'Carne Suave': 0,
            'Jamón y Queso': 0,
            'Humita': 0
        };
        const empanadaPrice = 900;
        let deliveryMethod = 'delivery';

        function showToast(text) {
            const toast = document.getElementById('toast');
            toast.innerText = `✅ ${text}`;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2000);
        }

        function addToCart(id, name, price) {
            const exist = cart.find(item => item.id === id);
            if (exist) {
                exist.quantity++;
            } else {
                cart.push({ id, name, price, quantity: 1 });
            }
            showToast(`Sumado: ${name}`);
            updateCartUI();
        }

        function changeEmpanadaFlavor(flavor, change) {
            empanadas[flavor] += change;
            if (empanadas[flavor] < 0) empanadas[flavor] = 0;
            
            const elementId = 'flavor-' + flavor.replace(' ', '').replace('ó', 'o');
            const element = document.getElementById(elementId);
            if(element) element.innerText = empanadas[flavor];
            
            updateCartUI();
        }

        function updateCartUI() {
            const empanadasCount = Object.values(empanadas).reduce((a, b) => a + b, 0);
            const empanadasTotal = empanadasCount * empanadaPrice;
            
            const otherCount = cart.reduce((acc, curr) => acc + curr.quantity, 0);
            const otherTotal = cart.reduce((acc, curr) => acc + (curr.price * curr.quantity), 0);
            
            const totalCount = empanadasCount + otherCount;
            const totalPrice = empanadasTotal + otherTotal;

            document.getElementById('bar-count').innerText = totalCount;
            document.getElementById('bar-total').innerText = totalPrice.toLocaleString('es-AR');

            const cartBar = document.getElementById('cart-bar');
            if (totalCount > 0) {
                cartBar.classList.remove('translate-y-full');
            } else {
                cartBar.classList.add('translate-y-full');
            }
        }

        function openCheckoutModal() {
            document.getElementById('checkout-modal').classList.remove('hidden');
            
            const summaryContainer = document.getElementById('checkout-summary');
            let html = '';
            
            cart.forEach(item => {
                html += `<div class="flex justify-between"><span>• ${item.quantity}x ${item.name}</span><span>$${(item.price * item.quantity).toLocaleString('es-AR')}</span></div>`;
            });
            
            Object.entries(empanadas).forEach(([flavor, qty]) => {
                if (qty > 0) {
                    html += `<div class="flex justify-between"><span>• ${qty}x Empanada de ${flavor}</span><span>$${(qty * empanadaPrice).toLocaleString('es-AR')}</span></div>`;
                }
            });
            
            summaryContainer.innerHTML = html;
        }

        function closeCheckoutModal() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function setDeliveryMethod(method) {
            deliveryMethod = method;
            const btnDelivery = document.getElementById('btn-delivery');
            const btnTakeaway = document.getElementById('btn-takeaway');
            const addrContainer = document.getElementById('address-container');

            if (method === 'delivery') {
                btnDelivery.className = "py-3 px-4 bg-rose-600 text-white font-bold text-xs uppercase rounded-xl transition-all shadow-md";
                btnTakeaway.className = "py-3 px-4 bg-[#292420] border border-stone-800 text-stone-300 font-semibold text-xs uppercase rounded-xl transition-all";
                addrContainer.classList.remove('hidden');
            } else {
                btnDelivery.className = "py-3 px-4 bg-[#292420] border border-stone-800 text-stone-300 font-semibold text-xs uppercase rounded-xl transition-all";
                btnTakeaway.className = "py-3 px-4 bg-rose-600 text-white font-bold text-xs uppercase rounded-xl transition-all shadow-md";
                addrContainer.classList.add('hidden');
            }
        }

        function sendOrder() {
            const name = document.getElementById('client-name').value.trim();
            const address = document.getElementById('client-address').value.trim();
            const change = document.getElementById('payment-change').value.trim();
            
            if (!name) {
                alert("Por favor, ingresá tu nombre.");
                return;
            }
            if (deliveryMethod === 'delivery' && !address) {
                alert("Por favor, escribí tu dirección para el delivery.");
                return;
            }

            let detailText = '';
            let empanadasText = [];
            
            cart.forEach(item => {
                detailText += `• *${item.quantity}x* ${item.name} ($${(item.price * item.quantity).toLocaleString('es-AR')})\n`;
            });

            Object.entries(empanadas).forEach(([flavor, qty]) => {
                if (qty > 0) {
                    empanadasText.push(`  - ${qty} de ${flavor}`);
                }
            });

            if (empanadasText.length > 0) {
                const empanadasCount = Object.values(empanadas).reduce((a, b) => a + b, 0);
                detailText += `• *${empanadasCount}x* Empanadas Caseras ($${(empanadasCount * empanadaPrice).toLocaleString('es-AR')}):\n${empanadasText.join('\n')}\n`;
            }

            const empanadasCount = Object.values(empanadas).reduce((a, b) => a + b, 0);
            const total = (empanadasCount * empanadaPrice) + cart.reduce((acc, curr) => acc + (curr.price * curr.quantity), 0);

            let msg = `📝 *NUEVO PEDIDO DE COMIDA* 📝\n\n`;
            msg += `👤 *Cliente:* ${name}\n`;
            msg += `🛵 *Tipo:* ${deliveryMethod === 'delivery' ? 'Envío a Domicilio' : 'Retiro por el Local'}\n`;
            
            if (deliveryMethod === 'delivery') {
                msg += `📍 *Dirección:* ${address}\n`;
            }
            
            msg += `\n*Detalle del Pedido:*\n${detailText}\n`;
            msg += `💰 *Total a abonar: $${total.toLocaleString('es-AR')}*\n`;
            
            if (change) {
                msg += `💵 *Paga con:* $${Number(change).toLocaleString('es-AR')}\n`;
                if (Number(change) > total) {
                    msg += `🔄 *Llevar cambio de:* $${(Number(change) - total).toLocaleString('es-AR')}\n`;
                }
            }

            const whatsappNumber = "5493546000000"; // Reemplazar por el del local
            window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`, '_blank');
        }
    </script>
</body>
</html>
