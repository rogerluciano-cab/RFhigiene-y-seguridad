<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reserva de Turnos - Barbería El Socio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }
        .font-urban {
            font-family: 'Oswald', sans-serif;
        }
        /* Efecto de movimiento diagonal para el Barber Pole */
        @keyframes barberPole {
            from { background-position: 0 0; }
            to { background-position: 40px 0; }
        }
        .barber-pole-banner {
            background: repeating-linear-gradient(
                -45deg,
                #ef4444,
                #ef4444 10px,
                #ffffff 10px,
                #ffffff 20px,
                #3b82f6 20px,
                #3b82f6 30px,
                #ffffff 30px,
                #ffffff 40px
            );
            background-size: 40px 40px;
            animation: barberPole 2s linear infinite;
        }
        /* Barra de scroll personalizada */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #09090b;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b82f6;
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen pb-28 selection:bg-blue-600 selection:text-white">

    <!-- Barber Pole Animado (Detalle arriba de todo) -->
    <div class="barber-pole-banner h-3 w-full border-b border-zinc-900"></div>

    <!-- Encabezado Urbano -->
    <header class="relative bg-zinc-900/50 border-b border-zinc-900 text-center py-10 px-4 overflow-hidden">
        <!-- Destellos azul y rojo de fondo -->
        <div class="absolute -top-20 -left-20 w-44 h-44 bg-blue-600/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-20 -right-20 w-44 h-44 bg-red-600/10 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 max-w-md mx-auto">
            <span class="inline-block px-3 py-1 bg-zinc-800 text-zinc-400 text-[10px] font-bold uppercase tracking-widest rounded-md mb-3 border border-zinc-700">
                Turnos Online Instántaneos
            </span>
            <h1 class="text-4xl font-bold font-urban text-white tracking-widest uppercase">BARBERÍA EL SOCIO</h1>
            <p class="text-zinc-400 text-xs mt-2 font-light">Navaja, Estilo & Tradición • Elegí tu horario</p>
        </div>
    </header>

    <main class="p-4 max-w-md mx-auto space-y-6">

        <!-- PASO 1: Elegir Servicio -->
        <section class="space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded bg-red-600 text-white flex items-center justify-center font-bold text-xs font-urban">01</span>
                <h2 class="text-md font-bold tracking-wider uppercase text-zinc-300 font-urban">Elegí el Servicio</h2>
            </div>
            
            <div class="grid grid-cols-1 gap-3">
                <!-- Servicio 1 -->
                <div onclick="selectService('Corte Clásico', 5000, this)" class="service-card bg-zinc-900/80 border border-zinc-850 hover:border-zinc-750 p-4 rounded-xl cursor-pointer transition-all duration-200 flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-zinc-100 text-sm tracking-wide">Corte Clásico</h3>
                        <p class="text-[11px] text-zinc-400 mt-1">Tijera o máquina, lavado incluido y peinado urbano.</p>
                    </div>
                    <span class="text-blue-400 font-bold font-urban text-md">$5.000</span>
                </div>
                <!-- Servicio 2 -->
                <div onclick="selectService('Corte + Barba', 7500, this)" class="service-card bg-zinc-900/80 border border-zinc-850 hover:border-zinc-750 p-4 rounded-xl cursor-pointer transition-all duration-200 flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-zinc-100 text-sm tracking-wide">Corte + Perfilado de Barba</h3>
                        <p class="text-[11px] text-zinc-400 mt-1">Corte completo y prolijado de barba con toalla húmeda y navaja.</p>
                    </div>
                    <span class="text-blue-400 font-bold font-urban text-md">$7.500</span>
                </div>
                <!-- Servicio 3 -->
                <div onclick="selectService('Servicio Premium', 10000, this)" class="service-card bg-zinc-900/80 border border-zinc-850 hover:border-zinc-750 p-4 rounded-xl cursor-pointer transition-all duration-200 flex justify-between items-center">
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-zinc-100 text-sm tracking-wide">Servicio Premium</h3>
                            <span class="bg-red-500/10 border border-red-500/20 text-red-400 text-[8px] px-1.5 py-0.5 rounded font-black uppercase">Facha Completa</span>
                        </div>
                        <p class="text-[11px] text-zinc-400 mt-1">Corte, barba, exfoliación facial, toalla caliente y bebida de cortesía.</p>
                    </div>
                    <span class="text-blue-400 font-bold font-urban text-md">$10.000</span>
                </div>
            </div>
        </section>

        <!-- PASO 2: Elegir Barbero -->
        <section class="space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded bg-blue-600 text-white flex items-center justify-center font-bold text-xs font-urban">02</span>
                <h2 class="text-md font-bold tracking-wider uppercase text-zinc-300 font-urban">Elegí tu Barbero</h2>
            </div>
            
            <div class="grid grid-cols-2 gap-3">
                <div onclick="selectBarber('Franco', this)" class="barber-card bg-zinc-900/80 border border-zinc-850 p-4 rounded-xl text-center cursor-pointer transition-all duration-200">
                    <div class="w-10 h-10 bg-zinc-800/80 rounded-full mx-auto mb-2 flex items-center justify-center text-lg shadow-inner">💈</div>
                    <h3 class="font-bold text-xs tracking-wide uppercase">Franco</h3>
                    <p class="text-[9px] text-zinc-500 mt-0.5">Especialista en degradés</p>
                </div>
                <div onclick="selectBarber('Mateo', this)" class="barber-card bg-zinc-900/80 border border-zinc-850 p-4 rounded-xl text-center cursor-pointer transition-all duration-200">
                    <div class="w-10 h-10 bg-zinc-800/80 rounded-full mx-auto mb-2 flex items-center justify-center text-lg shadow-inner">✂️</div>
                    <h3 class="font-bold text-xs tracking-wide uppercase">Mateo</h3>
                    <p class="text-[9px] text-zinc-500 mt-0.5">Experto en barbas clásicas</p>
                </div>
            </div>
        </section>

        <!-- PASO 3: Elegir Día -->
        <section class="space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded bg-red-600 text-white flex items-center justify-center font-bold text-xs font-urban">03</span>
                <h2 class="text-md font-bold tracking-wider uppercase text-zinc-300 font-urban">Seleccioná el Día</h2>
            </div>
            
            <div class="flex gap-2 overflow-x-auto pb-1 whitespace-nowrap">
                <button onclick="selectDay('Hoy', this)" class="day-btn px-5 py-3 bg-zinc-900/80 border border-zinc-850 text-zinc-300 rounded-xl text-xs font-bold uppercase tracking-wider transition-all">
                    Hoy
                </button>
                <button onclick="selectDay('Mañana', this)" class="day-btn px-5 py-3 bg-zinc-900/80 border border-zinc-850 text-zinc-300 rounded-xl text-xs font-bold uppercase tracking-wider transition-all">
                    Mañana
                </button>
                <button onclick="selectDay('Pasado Mañana', this)" class="day-btn px-5 py-3 bg-zinc-900/80 border border-zinc-850 text-zinc-300 rounded-xl text-xs font-bold uppercase tracking-wider transition-all">
                    Pasado Mañana
                </button>
            </div>
        </section>

        <!-- PASO 4: Elegir Horario -->
        <section class="space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded bg-blue-600 text-white flex items-center justify-center font-bold text-xs font-urban">04</span>
                <h2 class="text-md font-bold tracking-wider uppercase text-zinc-300 font-urban">Horarios Disponibles</h2>
            </div>
            
            <div class="grid grid-cols-4 gap-2">
                <button onclick="selectTime('09:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">09:00</button>
                <button onclick="selectTime('10:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">10:00</button>
                <button onclick="selectTime('11:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">11:00</button>
                <button onclick="selectTime('15:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">15:00</button>
                <button onclick="selectTime('16:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">16:00</button>
                <button onclick="selectTime('17:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">17:00</button>
                <button onclick="selectTime('18:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">18:00</button>
                <button onclick="selectTime('19:00', this)" class="time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all">19:00</button>
            </div>
        </section>

        <!-- PASO 5: Nombre del Cliente -->
        <section class="space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded bg-red-600 text-white flex items-center justify-center font-bold text-xs font-urban">05</span>
                <h2 class="text-md font-bold tracking-wider uppercase text-zinc-300 font-urban">Tus Datos</h2>
            </div>
            <input type="text" id="client-name" placeholder="Escribí tu nombre completo" class="w-full bg-zinc-900/80 border border-zinc-850 focus:border-blue-500 focus:outline-none p-4 rounded-xl text-zinc-200 text-xs placeholder:text-zinc-650 transition-all shadow-inner">
        </section>

    </main>

    <!-- Barra Inferior Flotante de Reservas -->
    <div class="fixed bottom-0 left-0 right-0 bg-zinc-900/90 backdrop-blur-md border-t border-zinc-800 p-4 z-40 shadow-2xl">
        <div class="max-w-md mx-auto">
            <button onclick="confirmTurn()" class="w-full bg-blue-600 hover:bg-blue-500 active:scale-95 text-white py-4 rounded-xl font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 transition-all duration-150 shadow-lg shadow-blue-600/10">
                <span>📅</span> Confirmar Turno por WhatsApp
            </button>
        </div>
    </div>

    <script>
        let selectedService = '';
        let selectedPrice = 0;
        let selectedBarber = '';
        let selectedDay = '';
        let selectedTime = '';

        function selectService(name, price, element) {
            selectedService = name;
            selectedPrice = price;
            
            document.querySelectorAll('.service-card').forEach(card => {
                card.className = "service-card bg-zinc-900/80 border border-zinc-850 p-4 rounded-xl cursor-pointer transition-all duration-200 flex justify-between items-center";
            });
            // Activo: Borde azul iluminado
            element.className = "service-card bg-zinc-900/80 border-2 border-blue-500 p-4 rounded-xl cursor-pointer transition-all duration-200 flex justify-between items-center shadow-lg shadow-blue-500/5";
        }

        function selectBarber(name, element) {
            selectedBarber = name;
            
            document.querySelectorAll('.barber-card').forEach(card => {
                card.className = "barber-card bg-zinc-900/80 border border-zinc-850 p-4 rounded-xl text-center cursor-pointer transition-all duration-200";
            });
            // Activo: Borde rojo iluminado
            element.className = "barber-card bg-zinc-900/80 border-2 border-red-500 p-4 rounded-xl text-center cursor-pointer transition-all duration-200 shadow-lg shadow-red-500/5";
        }

        function selectDay(day, element) {
            selectedDay = day;
            
            document.querySelectorAll('.day-btn').forEach(btn => {
                btn.className = "day-btn px-5 py-3 bg-zinc-900/80 border border-zinc-850 text-zinc-300 rounded-xl text-xs font-bold uppercase tracking-wider transition-all";
            });
            // Activo: Fondo azul sólido
            element.className = "day-btn px-5 py-3 bg-blue-600 text-white font-bold rounded-xl text-xs uppercase tracking-wider transition-all shadow-md shadow-blue-600/10";
        }

        function selectTime(time, element) {
            selectedTime = time;
            
            document.querySelectorAll('.time-btn').forEach(btn => {
                btn.className = "time-btn bg-zinc-900/80 border border-zinc-850 py-2.5 rounded-lg text-xs font-semibold text-zinc-300 transition-all";
            });
            // Activo: Fondo rojo sólido
            element.className = "time-btn bg-red-600 text-white font-bold py-2.5 rounded-lg text-xs transition-all shadow-md shadow-red-600/10";
        }

        function confirmTurn() {
            const clientName = document.getElementById('client-name').value.trim();

            if (!selectedService) {
                alert("Por favor, seleccioná un servicio.");
                return;
            }
            if (!selectedBarber) {
                alert("Por favor, seleccioná un barbero.");
                return;
            }
            if (!selectedDay) {
                alert("Por favor, elegí un día para tu turno.");
                return;
            }
            if (!selectedTime) {
                alert("Por favor, elegí una hora para tu turno.");
                return;
            }
            if (!clientName) {
                alert("Por favor, ingresá tu nombre para registrar el turno.");
                return;
            }

            // Generar el mensaje automático para WhatsApp
            const message = `💈 *TURNO RESERVADO - BARBERÍA EL SOCIO* 💈\n\n` +
                            `👤 *Cliente:* ${clientName}\n` +
                            `✂️ *Servicio:* ${selectedService} ($${selectedPrice.toLocaleString('es-AR')})\n` +
                            `🧔 *Barbero:* ${selectedBarber}\n` +
                            `📅 *Día:* ${selectedDay}\n` +
                            `⏰ *Hora:* ${selectedTime} hs\n\n` +
                            `_¡Espero la confirmación del turno!_`;

            const whatsappNumber = "5493546000000"; // Número real de la barbería
            window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
        }
    </script>
</body>
</html>
